bool MMHeatmapValues(datetime utc_time, double &direction, double &range_points)
{
   MqlDateTime value;
   TimeToStruct(utc_time, value);
   if(value.day_of_week < 1 || value.day_of_week > 5)
      return false;
   int day = value.day_of_week - 1;
   direction = MM_DIR_EFF[day][value.hour];
   range_points = MM_AVG_RANGE[day][value.hour];
   return true;
}

