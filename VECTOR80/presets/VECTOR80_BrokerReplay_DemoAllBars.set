; VECTOR80 demo preset using Python all-bar broker scores
; Demo only. Refresh the broker score CSV before each session.

; === Model / Signal ===
InpScoreMode=0||0||0||1||N
InpScoreFileCommon=VECTOR80_model_scores_live.csv
InpScoreTimeToleranceMin=0||0||1||50||N
InpDebugShiftSweep=false||false||0||true||N
InpDebugShiftSweepFromMin=-360||-360||1||-3600||N
InpDebugShiftSweepToMin=360||360||1||3600||N
InpDebugShiftSweepStepMin=30||30||1||300||N
InpAllowTrading=true||false||0||true||N
InpDrawArrows=true||false||0||true||N
InpSignalClusterCooldownMin=15||15||1||150||N
InpSameSideCooldownMin=15||15||1||300||N
InpEntryWindowBars=2||2||1||20||N

; === Demo Exploration ===
InpDemoExploreMode=false||false||0||true||N
InpDemoExploreMinScore=0.55||0.55||0.01||0.95||N
InpDemoExploreFallbackHeuristic=false||false||0||true||N

; === Adaptive UTC Threshold Rule ===
InpAdaptiveTimeRuleEnabled=true||false||0||true||N
InpAdaptiveAllowEntries=true||false||0||true||N
InpAdaptiveStartUtcMinutes=0||0||15||1425||N
InpAdaptiveEndUtcMinutes=120||120||15||1440||N
InpAdaptiveThresholdDelta=0.08||0.08||0.01||0.20||N
InpAdaptiveMinScore=0.70||0.70||0.01||0.95||N
InpAdaptiveShadowOutcomes=true||false||0||true||N
InpAdaptiveResearchMaxDelta=0.15||0.15||0.01||0.30||N
InpAdaptiveLogFile=VECTOR80_live_adaptive_thresholds.csv

; === ZigZag Lines MTF ===
InpZZIndicatorName=Market\ZigZag Lines MTF for MT5
InpSignalTF=5||0||0||49153||N
InpZZDepth=12||12||1||120||N
InpZZDeviation=5||5||1||50||N
InpZZBackstep=3||3||1||30||N
InpZZTmpMaxBars=20000||20000||1||200000||N
InpZZIndPeriod=0||0||1||10||N
InpZZScanBars=300||300||1||3000||N

; === Risk ===
InpRiskPct=1.0||1.0||0.1||10.0||N
InpMagic=20800080||20800080||1||208000800||N
InpMaxOpenPositions=2||2||1||10||N
InpMaxSpreadPips=2.5||2.5||0.1||10.0||N
InpSlippagePoints=20||20||1||200||N

; === Engine Risk ===
InpBuyStopPips=5.0||5.0||0.5||30.0||N
InpSellStopPips=8.0||8.0||0.5||30.0||N
InpTargetR=1.0||1.0||0.1||5.0||N
InpTimeoutMinutes=120||120||5||240||N

; === Retest Entry Test Mode ===
InpUseSellRetestEntry=false||false||0||true||N
InpSellRetestPips=2.0||2.0||0.1||10.0||N
InpRetestExpiryBars=2||2||1||10||N

; === Heuristic Proxy Test Mode ===
InpHeuristicLLThreshold=0.88||0.88||0.01||0.99||N
InpHeuristicHLThreshold=0.90||0.90||0.01||0.99||N
InpHeuristicHHThreshold=0.90||0.90||0.01||0.99||N

; === Live Python Bridge ===
InpRequireLiveBridge=true||false||0||true||N
InpExportLiveTicks=true||false||0||true||N
InpBridgeHeartbeatFile=VECTOR80_bridge_heartbeat.csv
InpMt5HeartbeatFile=VECTOR80_mt5_heartbeat.csv
InpScoreRequestFile=VECTOR80_score_requests.csv
InpBridgeMaxAgeSec=15||15||1||120||N
InpScoreWaitSec=30||30||1||120||N
InpBridgeAlertCooldownSec=900||900||60||3600||N
InpBridgePushNotifications=true||false||0||true||N

; === Logging ===
InpUseCommonFiles=true||false||0||true||N
InpEventLogFile=VECTOR80_live_events.csv
InpTradeLogFile=VECTOR80_live_trades.csv
InpDebugLogging=true||false||0||true||N

; === Time HUD ===
InpTimeHudEnabled=true||false||0||true||N
InpTimeHudCorner=0||0||0||3||N
InpTimeHudX=10||10||1||100||N
InpTimeHudY=20||20||1||200||N
InpTimeHudFontSize=9||9||1||16||N
InpTimeHudColor=16777215
InpTimeHudOpenColor=65280
InpTimeHudClosedColor=8421504
